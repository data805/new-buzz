[general]
enabled = yes
port = 5038
; AMI must never be exposed publicly. It listens on all interfaces so the app
; container can reach it through the Docker bridge, but the ACL below only
; admits loopback and private Docker networks; also firewall TCP 5038.
bindaddr = 0.0.0.0

[${ASTERISK_AMI_USER}]
secret = ${ASTERISK_AMI_PASSWORD}
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.255
permit = 172.16.0.0/255.240.0.0
read = call,system,originate
write = call,system,originate
