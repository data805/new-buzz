; PJSIP configuration for a Zambian SIP trunk (rendered from environment by entrypoint.sh).
; Works with registration-based trunks (username/password) and IP-authenticated trunks.

[global]
type=global
user_agent=BongoHiveVoiceAgent

[transport-${SIP_TRUNK_TRANSPORT}]
type=transport
protocol=${SIP_TRUNK_TRANSPORT}
bind=0.0.0.0:5060
external_media_address=${SIP_EXTERNAL_IP}
external_signaling_address=${SIP_EXTERNAL_IP}
local_net=${SIP_LOCAL_NET}

;REGISTRATION-BEGIN
[zm-trunk-auth]
type=auth
auth_type=userpass
username=${SIP_TRUNK_USERNAME}
password=${SIP_TRUNK_PASSWORD}

[zm-trunk-reg]
type=registration
transport=transport-${SIP_TRUNK_TRANSPORT}
outbound_auth=zm-trunk-auth
server_uri=sip:${SIP_TRUNK_HOST}:${SIP_TRUNK_PORT}
client_uri=sip:${SIP_TRUNK_USERNAME}@${SIP_TRUNK_HOST}
contact_user=${SIP_DID}
retry_interval=60
forbidden_retry_interval=300
expiration=3600
;REGISTRATION-END

[zm-trunk]
type=endpoint
transport=transport-${SIP_TRUNK_TRANSPORT}
context=from-trunk
disallow=all
; G.711 A-law is standard in Zambia / ITU region 1; u-law kept as fallback
allow=alaw,ulaw
outbound_auth=zm-trunk-auth
aors=zm-trunk
from_domain=${SIP_TRUNK_HOST}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
send_pai=yes
trust_id_inbound=yes

[zm-trunk]
type=aor
contact=sip:${SIP_TRUNK_HOST}:${SIP_TRUNK_PORT}
qualify_frequency=60

[zm-trunk-identify]
type=identify
endpoint=zm-trunk
match=${SIP_TRUNK_HOST}
