# =====================================================================
# BongoHive AI Voice Agent - configuration
# Copy to .env and fill in. Never commit .env. Values shown are examples.
# =====================================================================

# --- Core ------------------------------------------------------------
ENVIRONMENT=development                 # development | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_JSON=false
COOKIE_SECURE=false                     # true behind HTTPS (required in production)
SESSION_HOURS=12
AUTH_DISABLED=false                     # true = no sign-in, everyone is admin. Local demos only; refused in production
# CORS_ORIGINS=http://localhost:5173    # only needed if the UI is served from another origin

# Database: SQLite for a single box / development; PostgreSQL for production.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/data/voiceagent.db
# DATABASE_URL=postgresql+asyncpg://voiceagent:password@localhost:5432/voiceagent
POSTGRES_PASSWORD=change-me             # used by docker-compose

# First admin account (created only when the users table is empty; must change password on first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!12345

# --- Language model --------------------------------------------------
LLM_PROVIDER=ollama                     # ollama | openai (any OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434     # OpenAI-compatible: e.g. https://api.groq.com/openai/v1
LLM_MODEL=qwen2.5:3b-instruct           # GPU server: qwen2.5:7b-instruct or llama3.1:8b
LLM_API_KEY=
LLM_NUM_CTX=4096
LLM_TIMEOUT_S=20
LLM_FIRST_TOKEN_TIMEOUT_S=8
# Optional fallback used automatically if the primary fails (e.g. a hosted API)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# --- Speech-to-text (faster-whisper) ----------------------------------
STT_MODEL=small.en                      # base.en (fast) | small.en (balanced) | distil-large-v3 / large-v3-turbo (GPU)
STT_DEVICE=auto                         # auto | cpu | cuda
STT_COMPUTE_TYPE=int8                   # int8 on CPU; float16 is used automatically on CUDA
STT_BEAM_SIZE=1
STT_THREADS=4

# --- Text-to-speech ----------------------------------------------------
TTS_ENGINE=kokoro                       # kokoro (natural) | piper (fast, optional GPL package)
TTS_KOKORO_MODEL=kokoro/kokoro-v1.0.onnx        # or kokoro-v1.0.int8.onnx on small CPUs
TTS_KOKORO_VOICES=kokoro/voices-v1.0.bin
TTS_PIPER_VOICE=piper/en_GB-cori-high.onnx
TTS_THREADS=4

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODELS_DIR=./models
PRELOAD_MODELS=true
MAX_CONCURRENT_CALLS=4                  # size to your hardware (see docs/PERFORMANCE.md)

# --- Telephony ---------------------------------------------------------
TELEPHONY_PROVIDER=simulator            # simulator | asterisk
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092
ASTERISK_AMI_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=voiceagent
ASTERISK_AMI_PASSWORD=                  # random string; also used by the Asterisk container
ASTERISK_CALLBACK_TOKEN=                # random string shared with the dialplan
ASTERISK_TRUNK_ENDPOINT=zm-trunk
ASTERISK_DIAL_FORMAT=e164               # e164 | e164_no_plus | national | international - ask your provider
OUTBOUND_CALLER_ID=                     # your +260 DID, e.g. +260211000000
HUMAN_TRANSFER_TARGET=                  # PJSIP/reception (SIP phone) or +2609XXXXXXXX (via trunk)

# SIP trunk (read by the Asterisk container only)
SIP_TRUNK_HOST=sip.provider.example     # from your provider
SIP_TRUNK_PORT=5060
SIP_TRUNK_TRANSPORT=udp                 # udp | tcp | tls
SIP_TRUNK_USERNAME=                     # empty for IP-authenticated trunks
SIP_TRUNK_PASSWORD=
SIP_DID=                                # your number as the provider sends it
SIP_EXTERNAL_IP=                        # public IP of the Asterisk host
SIP_LOCAL_NET=10.0.0.0/8
RTP_START=10000
RTP_END=10200

# --- Outbound calling safety (OFF by default) ---------------------------
OUTBOUND_ENABLED=false                  # enable only after the compliance checklist in docs/COMPLIANCE.md
ALLOW_BULK_OUTBOUND=false
BULK_THRESHOLD=50
OUTBOUND_MAX_CALLS_PER_HOUR=30
OUTBOUND_MIN_HOURS_BETWEEN_CALLS=24
ALLOWED_COUNTRY_CODES=260

# --- Integrations --------------------------------------------------------
KNOWLEDGE_ALLOWED_DOMAINS=bongohive.co.zm
WEBHOOK_ALLOWED_HOSTS=                  # comma separated hosts workflows may call
WEBHOOK_SIGNING_SECRET=                 # HMAC-SHA256 signature in X-Signature-SHA256
N8N_BASE_URL=                           # e.g. http://n8n:5678
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMS_PROVIDER=                           # twilio | http
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_HTTP_URL=                           # generic gateway: POST {to, from, message} with Bearer token
SMS_HTTP_TOKEN=
